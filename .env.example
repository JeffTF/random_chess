# Firebase web app configuration.
# Copy to .env.local and fill in the values from
# Firebase Console > Project settings > Your apps > Web app.
#
# These values identify the project publicly; security comes from
# Firestore rules and Cloud Functions, never from hiding them.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Region where the callable functions are deployed.
VITE_FIREBASE_REGION=asia-southeast1

# Emulators are used automatically during `npm run dev`.
# Set to "false" to use the real project while developing.
# VITE_USE_FIREBASE_EMULATORS=true
